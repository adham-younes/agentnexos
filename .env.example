# ============================================================
# Agentnexos — Environment Variables (PLACEHOLDERS ONLY)
# ============================================================
# NEVER put real secrets in this file. Copy it to .env.local
# (which is gitignored) and fill values there, or set them in
# the Vercel project dashboard.
# ============================================================

# ---- Supabase (configure and verify for each deployment environment) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Legacy public alias (must match the same authorized project):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional model layer (Groq) ----
# Live model calls require these. Keys live in Vercel only, never copied locally.
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=

# ---- Feature flags ----
# Temporarily hide template placeholder sections that make unverified claims
# (testimonials / metrics / fabricated security stats). Files are NOT deleted.
NEXT_PUBLIC_SHOW_PLACEHOLDER_SECTIONS=false
# Keep disabled until quota migration, server credentials and live tests pass.
AGENTNEXOS_DEMO_ENABLED=false
AGENTNEXOS_SUPABASE_URL=https://ruereqpvykwnakcnmxha.supabase.co
# Optional dedicated server-only key; configure only in Vercel, never locally.
AGENTNEXOS_SUPABASE_SECRET_KEY=
