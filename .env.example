# ============================================================
# Agentnexos — Environment Variables (PLACEHOLDERS ONLY)
# ============================================================
# NEVER put real secrets in this file. Copy it to .env.local
# (which is gitignored) and fill values there, or set them in
# the Vercel project dashboard.
# ============================================================

# ---- Supabase (already configured in the Vercel project) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alias still present in the Vercel project:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Agentnexos model layer (Vercel AI Gateway) ----
# Local development uses this key. Vercel can also authenticate Gateway with
# its short-lived OIDC token. Never expose either value to the browser.
AI_GATEWAY_API_KEY=

# ---- Feature flags ----
# Temporarily hide template placeholder sections that make unverified claims
# (testimonials / metrics / fabricated security stats). Files are NOT deleted.
NEXT_PUBLIC_SHOW_PLACEHOLDER_SECTIONS=false
