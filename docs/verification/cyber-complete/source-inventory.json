  "functions": [
    {
      "name": "agentnexos_begin_turn",
      "definition": "CREATE OR REPLACE FUNCTION public.agentnexos_begin_turn(p_user_id uuid, p_conversation_id uuid, p_request_id uuid, p_content text, p_locale text)\n RETURNS uuid\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare v_id uuid; v_owner uuid; v_count bigint;\nbegin\n if p_locale not in ('ar','en') or char_length(p_content) not between 1 and 4000 then raise exception 'INVALID_TURN'; end if;\n if exists(select 1 from public.agentnexos_messages where request_id=p_request_id) then raise exception 'DUPLICATE_TURN'; end if;\n if p_conversation_id is null then\n  select count(*) into v_count from public.agentnexos_conversations where user_id=p_user_id;\n  if v_count >= 200 then raise exception 'CONVERSATION_LIMIT'; end if;\n  insert into public.agentnexos_conversations(user_id,title,locale) values(p_user_id,left(p_content,120),p_locale) returning id into v_id;\n else\n  select user_id into v_owner from public.agentnexos_conversations where id=p_conversation_id for update;\n  if v_owner is distinct from p_user_id then raise exception 'CONVERSATION_UNAVAILABLE'; end if;\n  v_id:=p_conversation_id;\n end if;\n select count(*) into v_count from public.agentnexos_messages where conversation_id=v_id;\n if v_count >= 200 then raise exception 'MESSAGE_LIMIT'; end if;\n insert into public.agentnexos_messages(conversation_id,user_id,request_id,role,content) values(v_id,p_user_id,p_request_id,'user',p_content);\n update public.agentnexos_conversations set updated_at=now() where id=v_id;\n return v_id;\nend $function$\n"
    },
    {
      "name": "agentnexos_demo_ready",
      "definition": "CREATE OR REPLACE FUNCTION public.agentnexos_demo_ready()\n RETURNS boolean\n LANGUAGE sql\n SET search_path TO ''\nAS $function$\n  select exists(select 1 from pg_catalog.pg_class where oid = 'public.agentnexos_demo_requests'::regclass);\n$function$\n"
    }
  ],
  "constraints": [
    {
      "name": "agentnexos_demo_requests_subject_hash_check",
      "table": "agentnexos_demo_requests",
      "definition": "CHECK ((length(subject_hash) = 64))"
    },
    {
      "name": "agentnexos_demo_requests_status_check",
      "table": "agentnexos_demo_requests",
      "definition": "CHECK ((status = ANY (ARRAY['reserved'::text, 'running'::text, 'completed'::text, 'failed'::text, 'cancelled'::text])))"
    },
    {
      "name": "agentnexos_demo_requests_pkey",
      "table": "agentnexos_demo_requests",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "agentnexos_demo_limits_singleton_check",
      "table": "agentnexos_demo_limits",
      "definition": "CHECK (singleton)"
    },
    {
      "name": "agentnexos_demo_limits_connection_daily_limit_check",
      "table": "agentnexos_demo_limits",
      "definition": "CHECK (((connection_daily_limit >= 1) AND (connection_daily_limit <= 1000000)))"
    },
    {
      "name": "agentnexos_demo_limits_check",
      "table": "agentnexos_demo_limits",
      "definition": "CHECK (((global_daily_limit >= connection_daily_limit) AND (global_daily_limit <= 1000000)))"
    },
    {
      "name": "agentnexos_demo_limits_pkey",
      "table": "agentnexos_demo_limits",
      "definition": "PRIMARY KEY (singleton)"
    },
    {
      "name": "agentnexos_profiles_display_name_check",
      "table": "agentnexos_profiles",
      "definition": "CHECK ((char_length(display_name) <= 100))"
    },
    {
      "name": "agentnexos_profiles_pkey",
      "table": "agentnexos_profiles",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "agentnexos_profiles_id_fkey",
      "table": "agentnexos_profiles",
      "definition": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "agentnexos_conversations_title_check",
      "table": "agentnexos_conversations",
      "definition": "CHECK (((char_length(title) >= 1) AND (char_length(title) <= 120)))"
    },
    {
      "name": "agentnexos_conversations_locale_check",
      "table": "agentnexos_conversations",
      "definition": "CHECK ((locale = ANY (ARRAY['ar'::text, 'en'::text])))"
    },
    {
      "name": "agentnexos_conversations_pkey",
      "table": "agentnexos_conversations",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "agentnexos_conversations_id_user_id_key",
      "table": "agentnexos_conversations",
      "definition": "UNIQUE (id, user_id)"
    },
    {
      "name": "agentnexos_conversations_user_id_fkey",
      "table": "agentnexos_conversations",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "agentnexos_messages_role_check",
      "table": "agentnexos_messages",
      "definition": "CHECK ((role = ANY (ARRAY['user'::text, 'assistant'::text])))"
    },
    {
      "name": "agentnexos_messages_content_check",
      "table": "agentnexos_messages",
      "definition": "CHECK (((char_length(content) >= 1) AND (char_length(content) <= 16000)))"
    },
    {
      "name": "agentnexos_messages_pkey",
      "table": "agentnexos_messages",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "agentnexos_messages_request_id_role_key",
      "table": "agentnexos_messages",
      "definition": "UNIQUE (request_id, role)"
    },
    {
      "name": "agentnexos_messages_conversation_id_sequence_key",
